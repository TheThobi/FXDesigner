# FX Designer server configuration: template. Copy to `.env` (never committed) and fill it.
# Without the PostgreSQL settings the server only serves the app (no accounts).

# ---- Deployment (deploy/autoupdate) -------------------------------------------------------
# Public repository: no token needed in the URL.
REPO_URL=https://github.com/OWNER/REPO.git
BRANCH=main
# Seconds between update checks.
POLL_SECONDS=60
# Docker network shared with the PostgreSQL container (see docs/deployment/server.md).
DB_NETWORK=shared-db

# ---- Server ----------------------------------------------------------------------------------
PORT=3000
# Public address of the site (cookies, Discord redirect, request origin checks).
PUBLIC_URL=https://fx.example.com
# 1 behind a reverse proxy (client IPs from X-Forwarded-For, for rate limiting).
TRUST_PROXY=1
# 0 closes email / password registration (Discord sign-in still works).
ALLOW_REGISTRATION=1

# ---- PostgreSQL --------------------------------------------------------------------------------
# Container name of the database on the shared network, or DATABASE_URL instead of these.
PGHOST=postgres
PGPORT=5432
PGDATABASE=fxdesigner
PGUSER=fxdesigner
PGPASSWORD=change-me

# ---- Local development (`npm run dev:server`) ---------------------------------------------------
# Replace the values above on your machine only: reach the database through a local port
# (e.g. an SSH tunnel `ssh -L 5433:localhost:5432 server`, or a local PostgreSQL) instead of
# the container name. Any DEV_ variable left empty keeps the normal one.
DEV_PGHOST=localhost
DEV_PGPORT=5433
DEV_PGDATABASE=
DEV_PGUSER=
DEV_PGPASSWORD=
# DEV_DATABASE_URL=postgres://fxdesigner:change-me@localhost:5433/fxdesigner
# The Vite dev server (default http://localhost:5173); also the Discord redirect in dev.
DEV_PUBLIC_URL=

# ---- Discord sign-in (optional) --------------------------------------------------------------
# https://discord.com/developers/applications → OAuth2 → redirect:
#   {PUBLIC_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
